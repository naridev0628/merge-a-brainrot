local Core=require('../src/server/Domain/FarmCore')
local Config=require('../src/shared/Config')
local Catalog=require('../src/shared/CreatureCatalog')
local core=Core.new(Config,Catalog,function() return .9 end)
local s=core:newSession(1,0,'carry')
assert(core:dispatch(s,'Buy',{'starter'},{now=0,alive=true,position={x=Config.BuyPads['1'],y=3,z=Config.BuyZ}}).code=='OK')
s.state.coinUnits=1000;s.state.lucky={id='block',baseTier=2}
local function cmd(action,id,block,x,z,extra)
    local args={id,block};if extra then table.insert(args,extra) end
    return core:dispatch(s,action,args,{now=1,alive=true,position={x=x or Config.LuckyX,y=3,z=z or Config.LuckyZ}})
end
assert(cmd('PickupLucky','near','block').code=='OK','Nearby block must enter held state')
assert(s.state.lucky.held==true and s.state.coinUnits==1000,'Pickup is free')
assert(cmd('PickupLucky','near','block').replayed,'Pickup retries must be idempotent')
assert(cmd('OpenLucky','foreign','wrong',0,0,'160').code=='MissingLucky')
assert(cmd('OpenLucky','stale','block',0,0,'1').code=='PriceChanged')
assert(cmd('DropLucky','drop','block',100,100).code=='OK' and not s.state.lucky.held)
assert(cmd('PickupLucky','far','block',100,100).code=='TooFar')
assert(cmd('OpenLucky','unheld','block',0,0,'160').code=='NotHoldingLucky')
assert(cmd('PickupLucky','pickup','block').code=='OK')
local reward=cmd('OpenLucky','open','block',100,100,'200')
assert(reward.code=='OK' and reward.speciesId=='tier_03','Held block unlocks while walking away')
assert(s.state.coinUnits==800 and s.state.lucky==nil)
assert(cmd('OpenLucky','open','block',100,100,'200').replayed and s.state.coinUnits==800)
s.state.lucky={id='discard',baseTier=3,held=true}
assert(cmd('DiscardLucky','discard','discard').code=='OK' and s.state.lucky==nil)
assert(s.state.coinUnits==800,'Discard must not charge or grant a reward')
assert(cmd('DiscardLucky','discard','discard').replayed)
print('PASS free proximity pickup, held unlock, drop, discard, quote, ownership and replay')
